{
  "name": "figma-ui-mcp",
  "version": "2.5.27",
  "private": true,
  "description": "Kiettt8 custom Figma MCP bridge with a one-command setup wizard for Codex, Claude, Cursor, VS Code, and Windsurf.",
  "mcpName": "io.github.kiettt8-product/figma-ui-mcp",
  "type": "module",
  "bin": {
    "figma-ui-mcp": "./server/cli.js"
  },
  "files": [
    "server/cli.js",
    "server/index.js",
    "server/bridge-daemon.js",
    "server/bridge-server.js",
    "server/code-executor.js",
    "server/design-system.js",
    "server/product-knowledge.js",
    "server/asset-resolver.js",
    "server/tool-definitions.js",
    "server/api-docs.js",
    "scripts/background-service.js",
    "scripts/export-design-system-bundle.js",
    "scripts/setup-mcp.js",
    "plugin/code.js",
    "plugin/manifest.json",
    "plugin/ui.html",
    "assets/plugin-ui-light.png"
  ],
  "scripts": {
    "setup": "node scripts/setup-mcp.js",
    "setup:background": "node scripts/background-service.js",
    "setup:dry-run": "node scripts/setup-mcp.js --dry-run",
    "bundle:export": "node scripts/export-design-system-bundle.js",
    "bundle:pack": "node scripts/export-design-system-bundle.js --pack-only",
    "test:setup": "node scripts/test-setup-mcp.mjs && node scripts/test-background-service.mjs",
    "test:design-system": "node scripts/test-design-system.mjs",
    "test:prototype": "node scripts/test-prototype.mjs",
    "test": "node scripts/test-all.mjs",
    "test:network": "FIGMA_UI_MCP_INCLUDE_NETWORK_TESTS=1 node scripts/test-all.mjs",
    "start": "node server/index.js",
    "build:plugin": "node scripts/build-plugin.js",
    "dev": "node --watch scripts/build-plugin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jsonc-parser": "^3.3.1"
  },
  "engines": { "node": ">=20" },
  "keywords": ["figma", "mcp", "model-context-protocol", "claude", "claude-code", "cursor", "windsurf", "vscode", "antigravity", "ai", "design", "plugin", "figma-plugin", "ui-generation", "figma-mcp", "ai-to-figma", "claude-to-figma", "code-to-figma", "design-to-code", "figma-bridge", "figma-automation"],
  "license": "MIT",
  "author": "Kiettt8",
  "homepage": "https://github.com/kiettt8-product/figma-ui-mcp#readme",
  "bugs": {
    "url": "https://github.com/kiettt8-product/figma-ui-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiettt8-product/figma-ui-mcp"
  }
}
